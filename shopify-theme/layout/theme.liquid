<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
 {%- capture ecom_header_content -%}{%- render 'ecom_header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#FFFFFF">
  <meta name="color-scheme" content="light">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- liquid
    assign page_title_full = page_title
    if current_tags
      assign tags_joined = current_tags | join: ', '
      assign page_title_full = page_title_full | append: ' &ndash; tagged "' | append: tags_joined | append: '"'
    endif
    if current_page != 1
      assign page_title_full = page_title_full | append: ' &ndash; Page ' | append: current_page
    endif
    unless page_title contains shop.name
      assign page_title_full = page_title_full | append: ' | ' | append: shop.name
    endunless
  -%}
  <title>{{ page_title_full }}</title>
  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}

  {%- comment -%} Social sharing {%- endcomment -%}
  {%- liquid
    assign og_type = 'website'
    if request.page_type == 'product'
      assign og_type = 'product'
    endif
  -%}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
  {%- if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- else %}
    <meta property="og:image" content="https:{{ 'og-image.jpg' | asset_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  {%- endif %}
  {%- if request.page_type == 'product' %}
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  <meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">

  {%- if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- else %}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {%- endif %}
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

  {%- comment -%} Fonts: Archivo (display), Inter (text), JetBrains Mono (labels) {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,600..900&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap">

  {%- comment -%} Tailwind utilities, precompiled from tailwind/theme.input.css {%- endcomment -%}
  {{ 'tailwind.css' | asset_url | stylesheet_tag }}
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.classList.replace('no-js', 'js');</script>

  <script>
    window.TA_THEME = {
      moneyFormat: {{ shop.money_format | json }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>

<body class="bg-white font-sans text-black antialiased">
  <a href="#main" class="skip-link">Skip to content</a>

  {% section 'header' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  <div id="toast" class="toast" popover="manual" aria-hidden="true">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false"><path d="m4.5 12.5 5 5L19.5 7"/></svg>
    <span data-toast-text></span>
  </div>
  <div class="sr-only" aria-live="polite" aria-atomic="true" id="page-live"></div>
{%- capture ecom_footer_content -%}{%- render 'ecom_footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}</body>
</html>
