<section class="mx-auto max-w-[28rem] px-4 py-16 sm:px-6">
  <h1 class="type-display text-[clamp(2rem,7vw,3rem)]">Reset password</h1>
  {%- form 'reset_customer_password', class: 'mt-8 space-y-4' -%}
    {%- if form.errors -%}<div class="text-sm text-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div><label for="reset-password" class="type-label block text-gray-600">New password</label><input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required class="field mt-2 w-full"></div>
    <div><label for="reset-confirm" class="type-label block text-gray-600">Confirm password</label><input id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required class="field mt-2 w-full"></div>
    <button type="submit" class="btn-primary w-full">Reset password</button>
  {%- endform -%}
</section>
