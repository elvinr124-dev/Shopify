{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = collections.all.products | sort: 'created_at' | last
  endif
-%}
<section id="final-cta" class="relative overflow-hidden" aria-labelledby="final-title-{{ section.id }}">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 md:py-28 lg:px-10">
    <div class="type-label flex items-center gap-4 text-gray-600">
      <span class="text-black">{{ section.settings.number }}</span><span class="h-px flex-1 bg-gray-200" aria-hidden="true"></span><span>{{ section.settings.eyebrow }}</span>
    </div>
    <h2 id="final-title-{{ section.id }}" class="type-display mt-8 max-w-[14ch] text-[clamp(2.4rem,10.5vw,8rem)] leading-[0.88]">{{ section.settings.heading }}</h2>
    <div class="mt-10 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      {%- if section.settings.show_countdown -%}
        <p class="countdown flex items-center gap-2.5 text-base text-gray-700" data-countdown>
          <span class="live-dot" aria-hidden="true"></span>
          <span data-countdown-fallback>{{ section.settings.countdown_fallback }}</span>
          <span data-countdown-live hidden>Order in <span class="font-mono font-medium tabular-nums text-black" role="timer" data-countdown-time>00:00:00</span> {{ section.settings.countdown_suffix }}</span>
        </p>
      {%- endif -%}
      <a href="#buy" class="btn-primary group md:min-w-[22rem]">
        <span>{{ section.settings.cta_label }}{% if p != blank %} - <span data-price>{{ p.selected_or_first_available_variant.price | money }}</span>{% endif %}</span>
        <svg class="size-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final call to action",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for the price)", "info": "Leave empty to use your newest product." },
    { "type": "text", "id": "number", "label": "Section number", "default": "06" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Last call tonight" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay warm. Skip the charger." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Claim Yours Now" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show free-shipping countdown to midnight", "default": true },
    { "type": "text", "id": "countdown_suffix", "label": "Countdown text", "default": "for free shipping today" },
    { "type": "text", "id": "countdown_fallback", "label": "Text before the countdown loads", "default": "Order today for free shipping." }
  ],
  "presets": [{ "name": "Final call to action" }]
}
{% endschema %}
