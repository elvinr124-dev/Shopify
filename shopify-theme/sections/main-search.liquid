<section class="mx-auto max-w-[90rem] px-4 py-14 sm:px-6 md:py-20 lg:px-10">
  <h1 class="type-display text-[clamp(2rem,7vw,4.5rem)]">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 flex max-w-xl gap-2">
    <label for="search-q" class="sr-only">Search</label>
    <input id="search-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" class="field flex-1">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="btn-primary">Search</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="mt-8 text-gray-600">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;</p>
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            <li>{% render 'product-card', card_product: item %}</li>
          {%- else -%}
            <li><a href="{{ item.url }}" class="font-semibold hover:underline">{{ item.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
