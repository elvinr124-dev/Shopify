{%- liquid
  assign muted_lines = section.settings.muted_lines | newline_to_br | split: '<br />'
-%}
<section class="border-b border-gray-200" aria-labelledby="unplugged-title-{{ section.id }}">
  <div class="mx-auto grid max-w-[90rem] md:grid-cols-12">
    <div class="relative md:col-span-5 md:border-r md:border-gray-200">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 768px) 42vw, 100vw', loading: 'lazy', class: 'aspect-[4/3] size-full object-cover md:aspect-auto md:h-full' }}
      {%- else -%}
        <img src="{{ 'detail-lifestyle.svg' | asset_url }}" width="1200" height="1200" loading="lazy" decoding="async" alt="" class="aspect-[4/3] size-full object-cover md:aspect-auto md:h-full">
      {%- endif -%}
    </div>
    <div class="flex flex-col justify-center px-4 py-14 sm:px-6 md:col-span-7 md:px-10 md:py-20 lg:px-16">
      <h2 id="unplugged-title-{{ section.id }}" class="type-display text-[clamp(1.8rem,7.6vw,4.25rem)] leading-[0.95] md:text-[min(4.4vw,4.25rem)]">
        {%- for line in muted_lines -%}
          {%- assign line_text = line | strip -%}
          {%- if line_text != blank %}<span class="block text-gray-500">{{ line_text }}</span>{% endif -%}
        {%- endfor -%}
        <span class="block">{{ section.settings.heading }}</span>
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="mt-6 max-w-md text-base leading-relaxed text-gray-600">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Statement with image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "muted_lines", "label": "Grey lines (one per line)", "default": "No batteries.\nNo cords.\nNo breakdowns." },
    { "type": "text", "id": "heading", "label": "Final line", "default": "Just warmth." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Nothing to charge before the drive, nothing to untangle on the couch, nothing to fail by February. Throw it on and it works, every single time." }
  ],
  "presets": [{ "name": "Statement with image" }]
}
{% endschema %}
