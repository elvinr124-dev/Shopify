<section id="trust" class="border-b border-gray-200" aria-labelledby="trust-title-{{ section.id }}">
  <div class="mx-auto max-w-[90rem] px-4 py-10 sm:px-6 md:py-14 lg:px-10">
    <div class="type-label flex items-center gap-4 text-gray-600">
      <span class="text-black">{{ section.settings.number }}</span><span class="h-px flex-1 bg-gray-200" aria-hidden="true"></span><span>{{ section.settings.eyebrow }}</span>
    </div>
    <h2 id="trust-title-{{ section.id }}" class="type-display mt-4 max-w-[22ch] text-balance text-[clamp(1.6rem,5.5vw,3rem)]">{{ section.settings.heading }}</h2>

    <ul class="mt-6 grid border-t border-gray-200 md:mt-8 lg:grid-cols-3 lg:border-l">
      {%- for block in section.blocks -%}
        <li class="flex gap-4 border-b border-gray-200 py-4 md:items-center md:gap-6 md:py-5 lg:flex-col lg:items-start lg:border-r lg:p-6" {{ block.shopify_attributes }}>
          <span class="grid size-12 shrink-0 place-items-center border border-gray-500 md:size-14" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'lock' -%}
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="1"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3M12 14.5v2.5"/></svg>
              {%- when 'support' -%}
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3.5" y="13.5" width="4" height="6" rx="1"/><rect x="16.5" y="13.5" width="4" height="6" rx="1"/><path d="M18.5 19.5c0 1.4-1.1 2-2.5 2h-3"/></svg>
              {%- when 'truck' -%}
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M2.5 6.5h11v10h-11zM13.5 9.5h4l3.5 3.5v3.5h-7.5"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
              {%- when 'return' -%}
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.3 7.5 9.5 4.3-1.2 7.5-5 7.5-9.5V6z"/><path d="m8.8 12 2.3 2.3 4.4-4.6"/></svg>
            {%- endcase -%}
          </span>
          <div>
            <h3 class="font-display text-lg font-bold uppercase leading-tight [font-stretch:112%] md:text-xl">{{ block.settings.title }}</h3>
            <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-gray-600">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "02" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bought with confidence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Zero hassle from cart to doorstep." }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "lock", "options": [
          { "value": "lock", "label": "Lock" }, { "value": "support", "label": "Headset" },
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Shield" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Secure Checkout" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "SSL-encrypted from your first click to your final payment." }
      ]
    }
  ],
  "presets": [{
    "name": "Trust badges",
    "blocks": [
      { "type": "badge", "settings": { "icon": "lock", "title": "Secure Checkout", "text": "SSL-encrypted from your first click to your final payment." } },
      { "type": "badge", "settings": { "icon": "support", "title": "24/7 Support", "text": "Real people, any hour. Email us and we'll sort it out." } },
      { "type": "badge", "settings": { "icon": "truck", "title": "Fast Holiday Fulfillment", "text": "Every order ships within 24 hours, and shipping is free today." } }
    ]
  }]
}
{% endschema %}
