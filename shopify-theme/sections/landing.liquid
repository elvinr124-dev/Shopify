{%- comment -%} Intro banner: what the store is about, directly above the product {%- endcomment -%}
<section id="top" class="landing border-b border-gray-200" aria-labelledby="landing-title-{{ section.id }}">
  <div class="mx-auto flex max-w-[90rem] flex-col justify-center gap-4 px-4 py-10 sm:px-6 md:min-h-[34svh] md:gap-6 md:py-14 lg:min-h-[44svh] lg:flex-row lg:items-end lg:justify-between lg:gap-12 lg:px-10 lg:py-16">
    <div class="min-w-0">
      {%- if section.settings.eyebrow != blank -%}
        <p class="type-label flex items-center gap-3 text-gray-700"><span class="h-px w-8 bg-gray-500" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="landing-title-{{ section.id }}" class="type-display mt-3 max-w-[14ch] text-balance text-[clamp(2.5rem,12vw,4rem)] md:mt-5 md:text-[clamp(3.5rem,8vw,5.5rem)] lg:text-[clamp(4rem,6.4vw,7rem)]">{{ section.settings.heading }}</h1>
    </div>
    {%- if section.settings.text != blank -%}
      <div class="lg:max-w-[38rem] lg:pb-2">
        <p class="text-base leading-relaxed text-gray-700 md:text-xl lg:text-[clamp(1.5rem,2vw,2rem)] lg:leading-snug">{{ section.settings.text }}</p>
        {%- if section.settings.link_label != blank -%}
          <a href="#buy" class="group mt-4 inline-flex min-h-11 items-center gap-2 border-b border-black text-[0.8125rem] font-semibold uppercase tracking-[0.08em] md:mt-6">
            {{ section.settings.link_label }}
            <svg class="size-4 transition-transform group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Intro banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome to Trending Arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's trending. Delivered." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We find what everyone's talking about and ship it fast, at an honest price. Here's the latest arrival." },
    { "type": "text", "id": "link_label", "label": "Link label (optional)", "default": "Shop the latest arrival" }
  ],
  "presets": [{ "name": "Intro banner" }]
}
{% endschema %}
