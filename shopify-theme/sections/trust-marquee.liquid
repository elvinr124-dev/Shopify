{%- liquid
  assign items = section.settings.items | split: '|'
-%}
<div class="marquee-band relative border-b border-gray-200 bg-white" data-marquee>
  <p class="sr-only">{{ items | join: '. ' }}</p>
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <ul class="marquee__group">
          {%- for item in items -%}<li>{{ item | strip }}</li>{%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
  <button type="button" class="marquee__toggle" data-marquee-toggle aria-pressed="false" aria-label="Pause scrolling banner">
    <svg class="icon-pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
    <svg class="icon-play size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12-7.5z"/></svg>
  </button>
</div>

{% schema %}
{
  "name": "Trust marquee",
  "settings": [
    { "type": "text", "id": "items", "label": "Items (separate with |)", "default": "Free shipping today | Ships within 24 hours | 30-day zero-risk returns | No batteries. No cords. | SSL-encrypted checkout | 24/7 support" }
  ],
  "presets": [{ "name": "Trust marquee" }]
}
{% endschema %}
