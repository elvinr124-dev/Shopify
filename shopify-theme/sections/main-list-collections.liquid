<section class="mx-auto max-w-[90rem] px-4 py-14 sm:px-6 md:py-20 lg:px-10">
  <h1 class="type-display text-[clamp(2rem,7vw,4.5rem)]">Collections</h1>
  <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3">
    {%- for item in collections -%}
      <li>
        <a href="{{ item.url }}" class="group block">
          <div class="aspect-square overflow-hidden bg-gray-100">
            {%- if item.featured_image != blank -%}
              {{ item.featured_image | image_url: width: 800 | image_tag: widths: '300, 400, 600, 800', sizes: '(min-width: 768px) 33vw, 50vw', loading: 'lazy', class: 'size-full object-cover' }}
            {%- endif -%}
          </div>
          <h2 class="mt-3 font-display text-lg font-bold uppercase [font-stretch:112%] group-hover:underline">{{ item.title }}</h2>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
