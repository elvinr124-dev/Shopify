<section id="highlights" class="border-b border-gray-200" aria-labelledby="highlights-title-{{ section.id }}">
  <div class="mx-auto max-w-[90rem] px-4 py-16 sm:px-6 md:py-24 lg:px-10">
    <div class="type-label flex items-center gap-4 text-gray-600">
      <span class="text-black">{{ section.settings.number }}</span><span class="h-px flex-1 bg-gray-200" aria-hidden="true"></span><span>{{ section.settings.eyebrow }}</span>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-12 md:items-end">
      <h2 id="highlights-title-{{ section.id }}" class="type-display max-w-[16ch] text-balance text-[clamp(1.75rem,6.4vw,3.75rem)] md:col-span-8">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="max-w-md text-base leading-relaxed text-gray-600 md:col-span-4 md:justify-self-end">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="mt-10 grid gap-4 md:mt-14 md:gap-5 lg:grid-cols-3">
      {%- for block in section.blocks -%}
        <article class="card flex flex-col bg-gray-100 md:grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:flex" {{ block.shopify_attributes }}>
          {%- if block.settings.style == 'number' -%}
            <div class="relative flex aspect-[4/3] flex-col justify-between overflow-hidden border-b border-gray-200 bg-white p-6 md:aspect-square md:border-b-0 md:border-r lg:border-b lg:border-r-0 lg:p-8">
              <span class="type-label text-gray-600">{{ block.settings.big_label }}</span>
              <p class="type-display text-[clamp(4.5rem,24vw,9rem)] leading-[0.8]" aria-hidden="true">{{ block.settings.big_number }}</p>
              <p class="font-display text-2xl font-extrabold uppercase leading-none [font-stretch:125%]" aria-hidden="true">{{ block.settings.big_caption }}</p>
            </div>
          {%- else -%}
            <div class="aspect-[4/3] overflow-hidden bg-gray-100 md:aspect-square">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 100vw', loading: 'lazy', class: 'card__img size-full object-cover' }}
              {%- else -%}
                <img src="{{ block.settings.fallback_image | asset_url }}" width="1200" height="1200" loading="lazy" decoding="async" alt="" class="card__img size-full object-cover">
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="flex flex-1 flex-col p-6 md:justify-center md:p-8 lg:justify-start">
            <span class="type-label text-gray-600">{{ block.settings.label }}</span>
            <h3 class="mt-3 font-display text-xl font-bold uppercase leading-tight [font-stretch:112%] lg:text-2xl">{{ block.settings.title }}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-gray-600">{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product highlights",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "03" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built different" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for comfort, not for a charger." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Heated gear dies, tangles and breaks. This is warmth the old-school way: dense materials, smart construction, zero electronics." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "style", "label": "Visual", "default": "image", "options": [ { "value": "image", "label": "Image" }, { "value": "number", "label": "Big number" } ] },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback_image", "label": "Placeholder image (used when no image is picked)", "default": "detail-sherpa.svg", "options": [
          { "value": "detail-sherpa.svg", "label": "Sherpa texture" }, { "value": "detail-stitching.svg", "label": "Stitching" }, { "value": "detail-lifestyle.svg", "label": "Lifestyle" }
        ] },
        { "type": "text", "id": "big_label", "label": "Big number: label", "default": "Money-back guarantee" },
        { "type": "text", "id": "big_number", "label": "Big number", "default": "30" },
        { "type": "text", "id": "big_caption", "label": "Big number: caption", "default": "Day zero-risk returns" },
        { "type": "text", "id": "label", "label": "Label", "default": "01 / Materials" },
        { "type": "text", "id": "title", "label": "Title", "default": "High-Grade Materials" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A heavyweight shell over thick, plush sherpa that traps your own body heat. Warm the second it's on." }
      ]
    }
  ],
  "presets": [{
    "name": "Product highlights",
    "blocks": [
      { "type": "card", "settings": { "style": "image", "fallback_image": "detail-sherpa.svg", "label": "01 / Materials", "title": "High-Grade Materials", "text": "A heavyweight shell over thick, plush sherpa that traps your own body heat. Warm the second it's on. No warm-up, no settings." } },
      { "type": "card", "settings": { "style": "number", "label": "02 / Guarantee", "title": "Zero-Return Risk", "text": "Wear it for 30 days. If it's not the coziest thing you own, send it back for a full refund. Your money is never stuck." } },
      { "type": "card", "settings": { "style": "image", "fallback_image": "detail-stitching.svg", "label": "03 / Construction", "title": "Premium Stitching", "text": "Reinforced double-stitched seams and cuffs, built for daily wear, couch marathons and wash after wash." } }
    ]
  }]
}
{% endschema %}
