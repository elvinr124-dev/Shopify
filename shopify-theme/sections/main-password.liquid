<section class="mx-auto flex min-h-svh max-w-[36rem] flex-col items-center justify-center px-4 py-16 text-center">
  <img src="{{ 'logo.svg' | asset_url }}" width="965" height="434" alt="{{ shop.name | escape }}" class="h-auto w-56">
  <h1 class="type-display mt-10 text-[clamp(2rem,8vw,3.5rem)]">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="mt-4 text-gray-600">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'mt-10 flex w-full flex-col gap-3 sm:flex-row' -%}
    <label for="password" class="sr-only">Password</label>
    <input id="password" type="password" name="password" autocomplete="current-password" placeholder="Enter store password" class="field flex-1">
    <button type="submit" class="btn-primary">Enter</button>
    {%- if form.errors -%}<p class="text-sm text-error sm:basis-full" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" } ]
}
{% endschema %}
