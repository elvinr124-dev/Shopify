<section class="mx-auto max-w-[60rem] px-4 py-14 sm:px-6 md:py-20">
  <h1 class="type-display text-[clamp(2rem,7vw,4rem)]">Your cart</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="mt-10">
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {%- for item in cart.items -%}
          <li class="flex gap-4 py-5">
            <a href="{{ item.url }}" class="block shrink-0">
              {%- if item.image != blank -%}
                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'size-20 bg-gray-100 object-cover md:size-24', alt: item.product.title }}
              {%- endif -%}
            </a>
            <div class="flex min-w-0 flex-1 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <a href="{{ item.url }}" class="font-semibold hover:underline">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="mt-0.5 text-[0.8125rem] text-gray-600">{{ item.variant.title }}</p>{%- endunless -%}
                <div class="mt-3 flex items-center gap-4">
                  <label class="sr-only" for="updates-{{ item.key }}">Quantity for {{ item.product.title }}</label>
                  <input id="updates-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="field w-24" inputmode="numeric">
                  <a href="{{ item.url_to_remove }}" class="text-btn">Remove</a>
                </div>
              </div>
              <p class="font-semibold">{{ item.final_line_price | money }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="mt-8 flex flex-col items-end gap-3">
        <p class="text-lg font-semibold">Subtotal: {{ cart.total_price | money }}</p>
        <p class="text-[0.8125rem] text-gray-600">Taxes and shipping calculated at checkout.</p>
        <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <button type="submit" name="update" class="btn-secondary">Update cart</button>
          <button type="submit" name="checkout" class="btn-primary">Secure Checkout</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p class="mt-6 text-gray-600">Your cart is empty.</p>
    <a href="{{ routes.root_url }}#buy" class="btn-primary mt-6">Shop the latest arrival</a>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
