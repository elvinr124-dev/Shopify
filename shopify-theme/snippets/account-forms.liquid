{%- comment -%} Combined "Sign up / Log in" page, used by the customer login and register templates {%- endcomment -%}
<section class="mx-auto max-w-[64rem] px-4 py-8 sm:px-6 md:py-10" aria-labelledby="account-title">
  <h1 id="account-title" class="type-display text-[clamp(2.25rem,8vw,3.5rem)]">Sign up / Log in</h1>
  <p class="mt-2 text-base leading-relaxed text-gray-700 md:text-lg">Track your orders, check out faster and be first to see new arrivals.</p>

  <div class="mt-6 grid gap-8 border-t border-gray-200 pt-6 md:grid-cols-2 md:gap-0 md:divide-x md:divide-gray-200">
    <div class="md:pr-8">
      <h2 class="font-display text-xl font-extrabold uppercase">Log in</h2>
      {%- form 'customer_login', class: 'mt-4 space-y-4' -%}
        {%- if form.errors -%}<div class="text-[0.9375rem] text-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div>
          <label for="login-email" class="type-label block text-gray-600">Email</label>
          <input id="login-email" type="email" name="customer[email]" autocomplete="email" required class="field mt-2 w-full">
        </div>
        <div>
          <label for="login-password" class="type-label block text-gray-600">Password</label>
          <input id="login-password" type="password" name="customer[password]" autocomplete="current-password" required class="field mt-2 w-full">
        </div>
        <button type="submit" class="btn-primary w-full">Log in</button>
      {%- endform -%}

      <details class="mt-4">
        <summary class="cursor-pointer text-[0.9375rem] underline underline-offset-4">Forgot your password?</summary>
        {%- form 'recover_customer_password', class: 'mt-3 space-y-3' -%}
          {%- if form.posted_successfully? -%}<p class="text-[0.9375rem]" role="status">Check your email for a link to reset your password.</p>{%- endif -%}
          <div>
            <label for="recover-email" class="type-label block text-gray-600">Email</label>
            <input id="recover-email" type="email" name="email" autocomplete="email" required class="field mt-2 w-full">
          </div>
          <button type="submit" class="btn-secondary w-full">Send reset link</button>
        {%- endform -%}
      </details>
    </div>

    <div class="md:pl-8">
      <h2 class="font-display text-xl font-extrabold uppercase">Create account</h2>
      {%- form 'create_customer', class: 'mt-4 space-y-4' -%}
        {%- if form.errors -%}<div class="text-[0.9375rem] text-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="reg-first" class="type-label block text-gray-600">First name</label>
            <input id="reg-first" type="text" name="customer[first_name]" autocomplete="given-name" class="field mt-2 w-full">
          </div>
          <div>
            <label for="reg-last" class="type-label block text-gray-600">Last name</label>
            <input id="reg-last" type="text" name="customer[last_name]" autocomplete="family-name" class="field mt-2 w-full">
          </div>
        </div>
        <div>
          <label for="reg-email" class="type-label block text-gray-600">Email</label>
          <input id="reg-email" type="email" name="customer[email]" autocomplete="email" required class="field mt-2 w-full">
        </div>
        <div>
          <label for="reg-password" class="type-label block text-gray-600">Password</label>
          <input id="reg-password" type="password" name="customer[password]" autocomplete="new-password" required class="field mt-2 w-full">
        </div>
        <label class="flex items-center gap-2 text-[0.9375rem] text-gray-700">
          <input type="checkbox" name="customer[accepts_marketing]" value="true" class="size-4 accent-black"> Email me about new arrivals and offers
        </label>
        <button type="submit" class="btn-secondary w-full">Create account</button>
      {%- endform -%}
    </div>
  </div>
</section>
