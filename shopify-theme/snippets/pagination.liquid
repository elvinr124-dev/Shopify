{%- if paginate.pages > 1 -%}
  <nav class="mt-14 flex items-center justify-center gap-6 text-sm font-semibold uppercase tracking-[0.08em]" aria-label="Pagination">
    {%- if paginate.previous -%}<a class="link" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
    <span class="text-gray-600">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
    {%- if paginate.next -%}<a class="link" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
  </nav>
{%- endif -%}
